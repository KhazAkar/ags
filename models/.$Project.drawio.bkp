        <mxCell id="R2RZIZFhC3APE5sBShbt-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ADC - Gravity&lt;/h1&gt;&lt;p&gt;This module would be responsible for reading soil moisture levels&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
