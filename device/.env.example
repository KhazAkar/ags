# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=ags/

# Database Configuration
DATABASE_URL=sqlite:///./data/ags.db

# GPIO Configuration
GPIO_WATER_PUMP=17
GPIO_LIGHT_RELAY=27
GPIO_FAN_RELAY=22

# Sensor Configuration
SOIL_MOISTURE_ADC=0
SOIL_WET_VALUE=25000
SOIL_DRY_VALUE=50000

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
