        <mxCell id="sl8ne3fgV3LR6pq-Fmdk-22" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Profile setup&lt;/h1&gt;&lt;div&gt;This module will be responsible for:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Plant profile storage&lt;/div&gt;&lt;div&gt;2. Signaling profile change to&lt;/div&gt;&lt;div&gt;message&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;router&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
